{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "web-app6",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "45bc5357-c637-479f-bc7a-792f7d5cec6a","database_name": "web-app6" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "65c60b5d8b5b4f2b8e8818580bdf42a7" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
